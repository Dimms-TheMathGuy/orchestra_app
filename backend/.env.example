# ───────────────────────── Orchestra Backend (NestJS) ─────────────────────────
# Copy to .env for local dev. In production, set these in your host's dashboard
# (Render / Fly.io env vars), NOT in a committed file.

# Runtime
NODE_ENV=development                 # set to "production" on the deployed backend
PORT=3000                            # host platforms usually inject PORT automatically

# Database (Postgres) — e.g. a Neon connection string
DATABASE_URL=postgresql://user:password@host:5432/orchestra?sslmode=require

# Frontend origin — used for CORS, GitHub OAuth redirect, password-reset links.
# Local: http://localhost:3001  |  Prod: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:3001

# Secrets — generate strong random values in prod (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production
CHAT_SECRET=0123456789abcdef0123456789abcdef   # MUST be exactly 32 chars (AES-256 key)

# WebAuthn / Passkeys — MUST match the frontend domain the browser runs on.
# Local: rp id "localhost", origin "http://localhost:3001"
# Prod:  rp id "your-frontend.vercel.app", origin "https://your-frontend.vercel.app"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001

# GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL must be: <BACKEND_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL GitHub webhooks POST to: <BACKEND_URL>/api/github/webhook (or your route)
GITHUB_WEBHOOK_URL=

# Notion (single internal integration — shared, not per-user yet)
NOTION_API_KEY=

# Zoom (Server-to-Server OAuth app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=                   # webhook signature verification token

# Groq / Gemini (AI summaries)
GROQ_API_KEY=
MOCK_GEMINI=false                    # set true to stub AI calls in dev
